# Copy to .env.local (never commit .env.local)



# Image/audio without your own API key: open-web search (Google Images, Openverse, Wikimedia, DDG).
# Hosted server GEMINI_API_KEY is NOT used for image/audio unless:
# ALLOW_HOSTED_GEMINI_IMAGE=1

# Gemini (optional — your key in Create uses AI; hosted key only if ALLOW_HOSTED_GEMINI_IMAGE=1)

GEMINI_API_KEY=your_google_ai_studio_key

# Image/audio/video frames (gemini-3.8-flash is text-only)
# Image output (gemini-3.8-flash is text-only). Free tier: gemini-3.1-flash-image (not *flash-lite*).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Local sign-in tokens when Firebase is not configured (16+ chars)
# STUDIO_AUTH_SECRET=change-me-to-a-long-random-string

# Cashfree sandbox (demo billing — never commit real production secrets)
# CASHFREE_APP_ID=your_test_app_id
# CASHFREE_SECRET_KEY=your_test_secret
# CASHFREE_ENV=sandbox



# Optional: OPENAI_API_KEY=sk-...

# Optional: ANTHROPIC_API_KEY=sk-ant-...



# Firebase (Auth + Firestore users) — from Firebase Console → Project settings

NEXT_PUBLIC_FIREBASE_API_KEY=

NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore on restrictive networks (default: long polling on)
# NEXT_PUBLIC_FIRESTORE_LONG_POLLING=1



# Prefer a Web app App ID from Firebase Console (Project settings → Your apps → Web).

# Android App IDs may not work for the web SDK.


